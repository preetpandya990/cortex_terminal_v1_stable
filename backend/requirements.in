# CRITICAL PIN — do NOT upgrade without coordinated numpy/TF/torch validation:
#   numpy ≥2.0 breaks TF 2.21 GPU (ml-dtypes ABI incompatibility).
#   scikit-learn ≥1.5 requires numpy ≥2.0.
#   Upgrade path: numpy → 2.x requires TF → 3.x and a full ML stack re-validation.
numpy==1.26.4
scikit-learn==1.4.0

# CRITICAL PIN — do NOT bump to pandas 3.x without also resolving the mlflow
# conflict below: mlflow's entire 3.x line (verified 3.0.0 through 3.14.0,
# the latest as of this pin) declares `pandas<3` and will not co-resolve
# with pandas 3.x. Confirmed via wheel METADATA (Requires-Dist: pandas<3) at
# both the floor and ceiling of the mlflow 3.x line — this is a hard
# upstream constraint, not an environment snapshot. Revisit once mlflow
# adds pandas 3.x support upstream.
pandas==2.3.3
pyarrow>=14.0.0

