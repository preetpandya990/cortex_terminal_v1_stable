    {
      "id": 1,
      "type": "stat",
      "title": "Explanation Latency P95",
      "description": "95th-percentile end-to-end explanation generation latency.\nSLO: < 5s — Alert: > 8s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 8 }
            ]
          },
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(llm_explanation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Explanation Success Rate",
      "description": "Percentage of explanation generation attempts completing successfully.\nSLO: ≥ 95% — Alert: < 90%.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green",  "value": 95 }
            ]
          },
          "unit": "percent",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "100 * sum(rate(llm_explanations_total{status=\"success\"}[$__rate_interval])) / sum(rate(llm_explanations_total[$__rate_interval]))",
          "legendFormat": "Success %",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "NIM → Ollama Fallback Rate",
      "description": "Percentage of LLM calls that fell back from NVIDIA NIM to local Ollama.\nSLO: < 5% — Alert: > 15%.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 15 }
            ]
          },
          "unit": "percent",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "100 * rate(llm_fallbacks_total[$__rate_interval]) / (sum(rate(llm_explanations_total[$__rate_interval])) + sum(rate(llm_sentiments_total[$__rate_interval])))",
          "legendFormat": "Fallback %",
          "instant": true,
          "refId": "A"
        }
      ]
    },

